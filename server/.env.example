# SHA-256 хэш пароля админки. Посчитать: printf 'ваш-пароль' | sha256sum
ADMIN_PASSWORD_HASH=
# Секрет подписи сессий. Задайте длинную случайную строку в production.
# Если не задан, используется ADMIN_PASSWORD_HASH.
SESSION_SECRET=
# Ключ ProxyAPI для AI-ассистента в админке (https://proxyapi.ru → Ключи API)
PROXYAPI_KEY=
# Модель (по умолчанию gpt-4o — умеет анализировать картинки)
# AI_MODEL=gpt-4o
# На обычном production-сервере с https включить Secure-куку.
# На Vercel она включается автоматически:
# COOKIE_SECURE=1
# PORT=3000
